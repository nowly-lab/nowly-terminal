  },
  "dependencies": {
    "@nowly-lab/terminal": "file:../../nowly-lab-terminal-0.2.1.tgz",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "43.7.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
