{
  "name": "nowly-terminal-native-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "rebuild": "electron-rebuild -f -w node-pty && node node_modules/@nowly-lab/terminal/scripts/prepare-pty.mjs",
    "build": "tsc --noEmit && vite build",
