{
  "name": "@nowly/terminal",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "description": "Embeddable PTY terminal toolkit inspired by Orca",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "docs/integration.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "scripts/prepare-pty.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./daemon": {
      "types": "./dist/daemon/index.d.ts",
      "import": "./dist/daemon/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "test:e2e": "playwright test",
    "dev": "tsx examples/react/dev.ts",
    "dev:ui": "vite --config examples/react/vite.config.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "postinstall": "node scripts/prepare-pty.mjs",
    "format": "prettier --write src tests examples scripts *.json *.ts",
    "dev:server": "tsx examples/react/server.ts",
    "dev:user": "tsx examples/react/dev.ts --user-shell",
    "prepack": "npm run build",
    "test:package": "node scripts/verify-package.mjs",
    "dev:clean": "tsx examples/react/dev.ts --clean-shell",
    "native:setup": "node scripts/setup-electron.mjs",
    "native": "node scripts/run-electron.mjs",
    "test:native": "playwright test --config playwright.electron.config.ts",
    "native:pack": "node scripts/pack-native.mjs",
    "test:native-package": "node scripts/verify-native.mjs",
    "test:codex": "pnpm build && node scripts/verify-codex.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.12.0-beta.300",
    "@xterm/addon-search": "0.17.0-beta.300",
    "@xterm/addon-serialize": "0.15.0-beta.300",
    "@xterm/addon-unicode11": "0.10.0-beta.300",
    "@xterm/addon-web-links": "0.13.0-beta.300",
    "@xterm/headless": "6.1.0-beta.302",
    "@xterm/xterm": "6.1.0-beta.303",
    "node-pty": "1.1.0",
    "ws": "8.21.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8",
    "prettier": "^3.9.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty",
      "esbuild"
    ]
  },
  "types": "./dist/protocol.d.ts",
  "bin": {
    "nowly-terminal": "./dist/cli.js"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/cli.js"
  ]
}
